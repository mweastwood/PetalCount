rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /charts/{chartId} {
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.userIds;
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.userIds;

      match /cycles/{cycleId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/charts/$(chartId)).data.userIds;

        match /observations/{observationId} {
          allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/charts/$(chartId)).data.userIds;
        }
      }
    }

    match /invitations/{invitationId} {
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid || 
        resource.data.invitationId == request.auth.token.email
      );
      allow update: if isSignedIn() && (
        resource.data.invitationId == request.auth.token.email
      );
      allow delete: if false;
    }
  }
}
